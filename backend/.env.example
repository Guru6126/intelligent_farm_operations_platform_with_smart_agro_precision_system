# Backend settings. Set these as environment variables before starting the server.
# Placeholders only — use your own values and never commit real secrets.
SERVER_PORT=8081
DB_URL=jdbc:mysql://localhost:3306/agroprecision?createDatabaseIfNotExist=true&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=replace_username
DB_PASSWORD=replace_password
# At least 32 random characters. Generate one: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=720
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# The account that signs up with this email also gets the admin role.
ADMIN_EMAIL=learningaws2005@gmail.com
